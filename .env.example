# Server
HOST=0.0.0.0
PORT=8000

# Lowest severity /api/check refuses (low, medium, high, critical)
BLOCK_THRESHOLD=high

# Allow targets on loopback/private addresses (local development only)
ALLOW_PRIVATE_TARGETS=false

# Supabase (usage logging)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
