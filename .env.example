# Server
HOST=0.0.0.0
PORT=8000

# Lowest severity /api/check refuses (low, medium, high, critical)
BLOCK_THRESHOLD=high

# Allow targets on loopback/private addresses (local development only)
ALLOW_PRIVATE_TARGETS=false

# Policy file (default: policies/default.yaml)
GUARDIAN_POLICY_FILE=

# API keys for POST /api/check, as name=key pairs (keys at least 16 chars).
# Empty = open demo mode, agent identity is self-reported.
GUARDIAN_API_KEYS=

# Keys allowed to watch every app:<name> dashboard session.
GUARDIAN_APPROVER_KEYS=

# OpenTelemetry: OTLP/HTTP endpoint for traces (empty = tracing off)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Put tool arguments on spans (off by default)
GUARDIAN_OTEL_CAPTURE_ARGUMENTS=false

# Supabase usage logging: off unless GUARDIAN_USAGE_LOGGING=true
GUARDIAN_USAGE_LOGGING=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
